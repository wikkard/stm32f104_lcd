<?xml version="1.0" encoding="UTF-8"?>
<screen>
    <view width="320" height="240" scrollable="false">
        <style name="style_screen"/>
        <lv_label name="title_label" x="10" y="12" width="300" text="STM32F103 + LVG TESTL"/>
        <lv_label name="subtitle_label" x="10" y="34" width="300" text="TESTING 123"/>
        <lv_obj name="red_block" x="32" y="66" width="72" height="48"
                clickable="false" scrollable="false">
            <style name="style_red_block"/>
        </lv_obj>
        <lv_obj name="green_block" x="124" y="66" width="72" height="48"
                clickable="false" scrollable="false">
            <style name="style_green_block"/>
        </lv_obj>
        <lv_obj name="blue_block" x="216" y="66" width="72" height="48"
                clickable="false" scrollable="false">
            <style name="style_blue_block"/>
        </lv_obj>
        <!-- Firmware updates the counter; the viewer shows an initial value. -->
        <lv_label name="counter_label" x="10" y="132" width="300" text="Counter: 0"/>
        <action_button name="settings_button" x="90" y="166" width="140" text="Settings">
            <screen_create_event screen="settings_screen" trigger="clicked"/>
        </action_button>
        <lv_label name="calibration_status" x="10" y="216" width="300"
                  text="Calibration: saved"/>
    </view>
</screen>

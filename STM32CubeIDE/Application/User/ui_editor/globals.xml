<?xml version="1.0" encoding="UTF-8"?>
<globals>
    <consts>
        <!-- Preview copy; firmware_version.h remains authoritative in firmware. -->
        <string name="firmware_version" value="0.1.0"/>
        <color name="screen_background" value="0x101820"/>
        <color name="button_background" value="0x245C80"/>
        <color name="button_pressed" value="0x387EA8"/>
        <color name="foreground" value="0xFFFFFF"/>
    </consts>
    <styles>
        <style name="style_screen" bg_color="#screen_background" bg_opa="255"
               text_color="#foreground" border_width="0" radius="0"
               pad_all="0"/>
        <style name="style_button" bg_color="#button_background" bg_opa="255"
               text_color="#foreground" border_width="0" radius="0"
               pad_all="0" shadow_width="0"/>
        <style name="style_button_pressed" bg_color="#button_pressed"/>
        <style name="style_label" text_color="#foreground" pad_all="0"/>
        <style name="style_red_block" bg_color="0xFF0000" bg_opa="255"
               border_width="0" radius="0" pad_all="0" shadow_width="0"/>
        <style name="style_green_block" bg_color="0x00FF00" bg_opa="255"
               border_width="0" radius="0" pad_all="0" shadow_width="0"/>
        <style name="style_blue_block" bg_color="0x0000FF" bg_opa="255"
               border_width="0" radius="0" pad_all="0" shadow_width="0"/>
        <style name="style_calibration_marker" bg_color="0xFFFF00" bg_opa="255"
               border_width="0" radius="0" pad_all="0" shadow_width="0"/>
    </styles>
</globals>
